# npm config LOCAL to this kit folder. Never edit ~/.npmrc.
# Relative paths resolve against the directory where npm runs. Load env.ps1
# first (". .\env.ps1"): it sets the same values as absolute paths, which
# take precedence over this file.
cache=./.npm-cache
logs-dir=./logs/npm
# NOTE: npm 11 rejects "prefix" in a project .npmrc. It is set per session
# via npm_config_prefix in env.ps1 (session only, no system change).

# Defense in depth: no lifecycle script runs unless explicitly
# overridden with --ignore-scripts=false (only after an audit).
ignore-scripts=true

save-exact=true
fund=false
update-notifier=false
