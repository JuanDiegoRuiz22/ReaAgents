{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["rea"],
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "ask": [
      "mcp__rea__*",
      "Bash(claude mcp *)",
      "PowerShell(claude mcp *)",
      "Bash(npm rebuild *)",
      "PowerShell(npm rebuild *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pypirc)",
      "Read(~/AppData/Local/Google/Chrome/User Data/**)",
      "Read(~/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(~/AppData/Local/BraveSoftware/**)",
      "Read(~/AppData/Local/Vivaldi/**)",
      "Read(~/AppData/Roaming/Mozilla/**)",
      "Read(~/AppData/Roaming/Opera Software/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",
      "Read(~/AppData/Local/Microsoft/Vault/**)",

      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.codex/**)",
      "Edit(~/.gemini/**)",
      "Edit(~/.cursor/**)",
      "Edit(~/.agents/**)",
      "Edit(~/AppData/Roaming/Claude/**)",
      "Edit(~/AppData/Roaming/Code/User/**)",
      "Edit(~/AppData/Roaming/npm/**)",

      "Bash(npm * -g)",
      "Bash(npm * -g *)",
      "Bash(npm * --global)",
      "Bash(npm * --global *)",
      "Bash(pnpm add -g *)",
      "Bash(yarn global *)",
      "Bash(bun add -g *)",
      "Bash(npx *rea-agents*)",
      "Bash(npx rea)",
      "Bash(npx rea *)",
      "Bash(rea)",
      "Bash(rea *)",
      "Bash(rea-agents *)",
      "Bash(*rea.mjs*)",
      "Bash(*node_modules/.bin/rea*)",
      "Bash(*install.sh*)",
      "Bash(claude mcp add -s user *)",
      "Bash(claude mcp add --scope user *)",
      "Bash(claude mcp add -s local *)",
      "Bash(claude mcp add --scope local *)",
      "Bash(sudo *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(sh -)",
      "Bash(bash -)",

      "PowerShell(npm * -g)",
      "PowerShell(npm * -g *)",
      "PowerShell(npm * --global)",
      "PowerShell(npm * --global *)",
      "PowerShell(npx *rea-agents*)",
      "PowerShell(npx rea)",
      "PowerShell(npx rea *)",
      "PowerShell(*rea.mjs*)",
      "PowerShell(*node_modules\\.bin\\rea*)",
      "PowerShell(*install.sh*)",
      "PowerShell(claude mcp add -s user *)",
      "PowerShell(claude mcp add --scope user *)",
      "PowerShell(claude mcp add -s local *)",
      "PowerShell(claude mcp add --scope local *)",
      "PowerShell(Invoke-Expression)",
      "PowerShell(Invoke-Expression *)",

      "mcp__rea__capture_process_scenario",
      "mcp__rea__execute_rizin_command",
      "mcp__rea__start_rizin_debug_session",
      "mcp__rea__rizin_debug_command",
      "mcp__rea__cutter_command",
      "mcp__rea__load_frida_script",
      "mcp__rea__instrument_with_frida",
      "mcp__rea__capture_browser_scenario",
      "mcp__rea__install_adb_package",
      "mcp__rea__uninstall_adb_package",
      "mcp__rea__push_adb_file"
    ]
  }
}
